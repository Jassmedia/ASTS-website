# WordPress backend (headless CMS) used by the front end's same-domain proxy
# (middleware.js on Vercel, server/vite-wp-proxy.js locally). Set these in the
# Vercel project settings (Environment Variables) and, for local testing, in .env.
#
# Where WordPress is reachable. Before the domain switch this is the live site
# itself; after the switch it must be a separate host that serves the same
# WordPress install (e.g. https://cms.aststraining.com).
WP_ORIGIN=https://aststraining.com
# The public address WordPress is configured with (Settings > General). Keep as is.
PUBLIC_ORIGIN=https://aststraining.com
# Shared secret checked by wordpress/mu-plugins/asts-proxy.php (needed after the
# domain switch so WordPress trusts the forwarded host and visitor IP).
WP_PROXY_SECRET=
